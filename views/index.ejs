<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jatin Dhiman - Portfolio</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet" />
  <link rel="shortcut icon" href="assets/favicon.png" type="image/x-icon">
  <link rel="stylesheet" href="css/style.css">
</head>

<body>

  <div id="cursor"><span id="cursor-text"></span></div>
  <div id="cursor-ring"></div>

  <div id="loader">
    <div id="loader-text">JATIN</div>
    <div id="loader-bar"></div>
  </div>

  <nav>
    <div class="nav-logo">
      <div class="nav-logo-box">JD</div>JATIN
    </div>

    <ul class="nav-links">
      <li><a href="#services">Services</a></li>
      <li><span class="nav-sep">/</span></li>
      <li><a href="#works">Work</a></li>
      <li><span class="nav-sep">/</span></li>
      <li><a href="#experience">Experience</a></li>
      <li><span class="nav-sep">/</span></li>
      <li><a href="#about">About</a></li>
    </ul>

    <div class="nav-right" style="display: flex; align-items: center; gap: 20px;">
      <a href="#contact" style="text-decoration:none;" class="desktop-btn"><button
          class="btn-hire hover-target"><span>Hire Me</span></button></a>

      <div class="hamburger hover-target" id="hamburgerBtn">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>

  <div class="mobile-menu" id="mobileMenu">

    <div class="close-menu hover-target" id="closeMenuBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </div>

    <ul class="mobile-menu-links">
      <li><a href="#home" class="mobile-link hover-target">Home</a></li>
      <li><a href="#about" class="mobile-link hover-target">About</a></li>
      <li><a href="#services" class="mobile-link hover-target">Services</a></li>
      <li><a href="#works" class="mobile-link hover-target">Works</a></li>
      <li><a href="#experience" class="mobile-link hover-target">Experience</a></li>
      <li><a href="#contact" class="mobile-link hover-target">Contact</a></li>
    </ul>
  </div>

  <section class="hero" id="home">
    <div class="hero-bg-circle"></div>
    <div class="hero-inner">
      <p class="hero-tag"><%- portfolioData.hero.tag %></p>
      <div class="hero-name-wrap hover-target">
        <div class="hero-name">
          <span>
            <%= portfolioData.hero.firstName %>&nbsp;
          </span><span>
            <%= portfolioData.hero.lastName %>
          </span>
        </div>
        <div class="hero-photo-wrap">
          <img src="assets/myimg.png" alt="Jatin Dhiman">
        </div>
      </div>
    </div>
    <div class="scroll-hint">Scroll down<div class="scroll-arrow"></div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-big">ABOUT</div>
    <div class="about-inner">
      <div class="about-arrow reveal">↗</div>
      <div class="about-text">
        <h2 class="reveal"><%- portfolioData.about.title %></h2>
        <p class="reveal reveal-delay-1">
          <%= portfolioData.about.description %>
        </p>
        <a href="#services" style="text-decoration:none;"><span
            class="about-tag hover-target reveal reveal-delay-2">What I Do ↓</span></a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-dark" id="services">
    <div class="section-inner">
      <div class="section-header"><span class="section-label reveal">What I Do</span></div>
      <div class="section-title reveal">MY SERVICES</div>
      <div class="services-grid">
        <% portfolioData.services.forEach((service, index)=> { %>
          <div class="service-item reveal hover-target">
            <span class="service-num">0<%= index + 1 %></span>
            <h3>
              <%= service.title %>
            </h3>
            <p>
              <%= service.description %>
            </p>
          </div>
          <% }) %>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" id="works">
    <div class="section-inner">
      <div class="section-header"><span class="section-label reveal">Selected Works</span></div>
      <div class="section-title reveal">PROJECTS</div>
      <% portfolioData.projects.forEach((project, index)=> { %>
        <div class="work-item reveal hover-target project-card" data-project-url="<%= project.url %>">
          <span class="work-name">
            <%= project.name %>
          </span>
          <span class="work-type">
            <%= project.type %>
          </span>
        </div>
        <% }) %>
    </div>
  </section>

  <section class="section-padding bg-dark" id="process">
    <div class="section-inner">
      <div class="section-header"><span class="section-label reveal">How I Work</span></div>
      <div class="section-title reveal">MY PROCESS</div>

      <div class="process-grid">
        <div class="process-step reveal hover-target">
          <span class="process-num">01</span>
          <h3>Ideation</h3>
          <p>Understanding the problem statement, brainstorming logical approaches, and planning the project
            architecture.</p>
        </div>
        <div class="process-step reveal reveal-delay-1 hover-target">
          <span class="process-num">02</span>
          <h3>Design</h3>
          <p>Structuring the user interface with HTML/CSS and planning the core C++ algorithms for optimal performance.
          </p>
        </div>
        <div class="process-step reveal reveal-delay-2 hover-target">
          <span class="process-num">03</span>
          <h3>Development</h3>
          <p>Writing clean, efficient code and integrating front-end systems with logical back-end structures.</p>
        </div>
        <div class="process-step reveal reveal-delay-3 hover-target">
          <span class="process-num">04</span>
          <h3>Testing</h3>
          <p>Hunting for bugs, securing vulnerabilities, and ensuring the final product works flawlessly before launch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray" id="experience">
    <div class="section-inner">
      <div class="section-header"><span class="section-label reveal">Involvement</span></div>
      <div class="section-title reveal">EXPERIENCE</div>
      <div class="exp-list">
        <% portfolioData.experience.forEach((exp, index)=> { %>
          <div class="exp-item reveal hover-target">
            <span class="exp-year">
              <%= exp.year %>
            </span>
            <span class="exp-role">
              <%= exp.role %>
            </span>
            <span class="exp-company">
              <%= exp.company %>
            </span>
          </div>
          <% }) %>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" id="testimonials">
    <div class="section-inner testimonial-wrap">
      <div class="quote-mark reveal">"</div>
      <p class="testimonial-text reveal reveal-delay-1">
        Your work is going to fill a large part of your life, and the only way to be truly satisfied is to do what you
        believe is great work. And the only way to do great work is to love what you do.
      </p>
      <p class="testimonial-author reveal reveal-delay-2">Steve Jobs <span>Co-founder, Apple Inc.</span></p>
    </div>
  </section>

  <section class="section-padding bg-dark" id="contact">
    <div class="section-inner contact-grid">
      <div class="contact-info">
        <h2 class="reveal">LET'S<br>BUILD.</h2>
        <p class="reveal reveal-delay-1">Got a web project in mind or need a strong partner for your next hackathon?
          Drop your details below and let's turn it into reality.</p>
      </div>

      <form id="contactForm" class="contact-form reveal reveal-delay-2">
        <div class="form-group">
          <input type="text" id="name" name="name" required>
          <label for="name">Your Name</label>
        </div>
        <div class="form-group">
          <input type="email" id="email" name="email" required>
          <label for="email">Email Address</label>
        </div>
        <div class="form-group">
          <textarea id="message" name="message" required></textarea>
          <label for="message">What are we building?</label>
        </div>

        <button type="submit" id="submitBtn" class="btn-submit hover-target">Send Message</button>

        <p id="formStatus" style="margin-top: 15px; font-weight: bold;"></p>
      </form>
    </div>
  </section>

  <footer>
    <div class="footer-inner">
      <div class="footer-cta reveal">LET'S<br><span>CODE</span><br>TOGETHER</div>
      <a href="mailto:<%= portfolioData.contact.email %>" class="footer-email reveal hover-target">
        <%= portfolioData.contact.email %>
      </a>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Jatin Dhiman</span>
      <span>All rights reserved</span>
    </div>
  </footer>
  <script src="js/script.js"></script>
</body>

</html>